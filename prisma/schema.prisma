datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  student
  parent
  teacher
  guest
}

model Students {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @default(uuid())
  citizen_id         String?
  passport_id        String?
  first_name         String
  last_name          String
  school             String?
  province           String?
  email              String               @unique
  phone              String
  password_hash      String
  role               Role                 @default(student)
  created_at         DateTime             @default(now())
  OAuthCode          OAuthCode[]
  oAuthToken         oAuthToken[]
  RegisterActivities RegisterActivities[]
  EStamp             EStamp[]
  TakePicture        TakePicture[]
  sitcerts           SITCert[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String
  expiresAt DateTime
}

model TakePicture {
  id        Int      @id @default(autoincrement())
  studentId Int
  image_url String
  taken_at  DateTime @default(now())

  student Students @relation(fields: [studentId], references: [id])
}

model Admins {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  password_hash String
  email         String       @unique
  name          String
  created_at    DateTime     @default(now())
  Activities    Activities[]
  Staffs        Staffs[]
}

model Staffs {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password_hash String
  name          String
  email         String         @unique
  created_at    DateTime       @default(now())
  create_by     Int
  created_by    Admins         @relation(fields: [create_by], references: [id])
  StaffMapping  StaffMapping[]
  EStamp        EStamp[]
}

// University Structure
/**
 * * University Structure:
 * - Faculty
 * - Department
 */
model Faculty {
  id          Int          @id @default(autoincrement())
  name_th     String
  name_en     String
  created_at  DateTime     @default(now())
  departments Department[]
}

model Department {
  id         Int          @id @default(autoincrement())
  name_th    String
  name_en    String
  facultyId  Int
  faculty    Faculty      @relation(fields: [facultyId], references: [id])
  created_at DateTime     @default(now())
  activities Activities[]
}

/**
 * * Types of activities:
 * - workshop: กิจกรรมที่ลงทะเบียนได้เฉพาะนักเรียนที่สมัครเข้าร่วมงานแล้ว
 * - regis_activity: กิจกรรมที่ลงทะเบียนได้เฉพาะนักเรียนที่สมัครเข้าร่วมงานแล้ว
 * - non_regis_activity: กิจกรรมที่เปิดให้ทุกคนเข้าร่วมได้
 */
enum ActivityType {
  workshop
  regis_activity
  non_regis_activity
}

model Activities {
  id            Int          @id @default(autoincrement())
  activity_type ActivityType

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  title                         String               @db.VarChar(1000)
  description                   String               @db.VarChar(10000)
  date                          String
  round                         Int
  start_time                    String
  end_time                      String
  location                      String
  point                         Int
  form_link                     String?
  display                       Boolean              @default(true)
  image_url                     String?
  stars                         Int                  @default(0)
  max_participants              Int
  current_register_participants Int                  @default(0)
  created_at                    DateTime             @default(now())
  Admins                        Admins?              @relation(fields: [ownerId], references: [id])
  ownerId                       Int?
  RegisterActivities            RegisterActivities[]
  StaffMapping                  StaffMapping[]
  EStamp                        EStamp[]
}

model RegisterActivities {
  id            Int      @id @default(autoincrement())
  studentId     Int
  activityId    Int
  registered_at DateTime @default(now())

  student  Students   @relation(fields: [studentId], references: [id])
  activity Activities @relation(fields: [activityId], references: [id])

  @@unique([studentId, activityId])
}

model StaffMapping {
  id         Int      @id @default(autoincrement())
  staffId    Int
  activityId Int
  created_at DateTime @default(now())

  staff    Staffs     @relation(fields: [staffId], references: [id])
  activity Activities @relation(fields: [activityId], references: [id])

  @@unique([staffId, activityId])
}

model EStamp {
  id         Int      @id @default(autoincrement())
  studentId  Int
  activityId Int
  stampBy    Int
  issued_at  DateTime @default(now())
  rating     Int?
  feedback   String?  @db.VarChar(1000)

  //relations student and activity and staff
  student  Students   @relation(fields: [studentId], references: [id])
  activity Activities @relation(fields: [activityId], references: [id])
  staff    Staffs     @relation(fields: [stampBy], references: [id])
}

model PublicSurvey {
  id                     Int      @id @default(autoincrement())
  participantType        String
  educationLevel         String?
  interestLevel          String?
  preferredFaculty       Json? // เก็บหลายคณะเป็น JSON
  infoChannels           Json? // ช่องทางข่าวสารหลายค่า
  factors                Json? // ปัจจัยหลายค่า
  creditTransferInterest Int?
  teachingMode           String?
  confusionRanking       Json? // 3 อันดับพระจอม
  interestKMUTT          String?
  createdAt              DateTime @default(now())
}

// OAuth2
model OAuthClient {
  id            Int         @id @default(autoincrement())
  name          String
  client_id     String      @unique
  client_secret String
  redirect_uris String
  created_at    DateTime    @default(now())
  codes         OAuthCode[]
}

model OAuthCode {
  code       String   @id
  studentId  Int
  clientId   String
  expires_at DateTime

  student Students    @relation(fields: [studentId], references: [id])
  client  OAuthClient @relation(fields: [clientId], references: [client_id])

  created_at DateTime @default(now())
}

model oAuthToken {
  id           Int      @id @default(autoincrement())
  access_token String   @unique
  studentId    Int
  clientId     String
  expires_at   DateTime

  student    Students @relation(fields: [studentId], references: [id])
  created_at DateTime @default(now())
}

model SITCert {
  studentId Int
  certName  String

  student Students @relation(fields: [studentId], references: [id])

  @@id([studentId, certName])
}

model LandingSchedule {
  id              Int      @id @default(autoincrement())
  time            String   @db.VarChar(100)
  session         String   @default("all") @db.VarChar(50)
  category        String   @db.VarChar(150)
  categoryColor   String   @default("orange") @db.VarChar(50)
  title           String   @db.VarChar(500)
  details         Json?
  subSectionTitle String?  @db.VarChar(500)
  subSectionItems Json?
  isBreak         Boolean  @default(false)
  orderIndex      Int      @default(0)
  display         Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt
}

model LandingBooth {
  id         Int      @id @default(autoincrement())
  location   String   @db.VarChar(500)
  units      Json
  orderIndex Int      @default(0)
  display    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

