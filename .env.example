NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_IMAGE=ghcr.io/2b-kmutt/kmutt-openhouse-app:latest

# Database
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/openhouse-prod

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
EXTERNAL_JWT_SECRET=your_external_jwt_secret_here

# Object Storage RustFS
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=your_rustfs_secret_key
S3_BUCKET_NAME=openhouse-uploads
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/openhouse-uploads

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SMTP
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_smtp_app_password
