# ==========================================
# Application & Server Configuration
# ==========================================
PORT=3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ==========================================
# Database Configuration (MySQL / Prisma)
# ==========================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/kmutt_openhouse"
# (Optional) Used for production Docker / backup scripts
MYSQL_ROOT_PASSWORD_PROD="your_mysql_root_password"

# ==========================================
# NextAuth Configuration
# ==========================================
# Canonical URL of the application
NEXTAUTH_URL="http://localhost:3000"
# Secret key for encrypting NextAuth JWT / cookies (Generate with: openssl rand -hex 32)
NEXTAUTH_SECRET="your_nextauth_secret_here"

# ==========================================
# External JWT Secret
# ==========================================
# Secret key used for signing external API access tokens
EXTERNAL_JWT_SECRET="your_external_jwt_secret_here"

# ==========================================
# Supabase Configuration (Storage & Uploads)
# ==========================================
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Supabase Anon / Public Key (used on client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
# Supabase Service Role Key (used on backend for image uploads & backup scripts)
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ==========================================
# SMTP / Email Configuration (Password Reset)
# ==========================================
# Sender email address (e.g. Gmail)
SMTP_USER="your-email@gmail.com"
# Gmail App Password (16 characters) or SMTP password
SMTP_PASS="your_smtp_app_password"
