# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# phpMyAdmin
PMA_BLOWFISH_SECRET=your_blowfish_secret_32_chars

# RustFS Object Storage
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=your_rustfs_secret_key

# Grafana Credentials (required for monitoring stack)
GRAFANA_ADMIN_USER=your_grafana_admin_username
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# Ports (Optional overrides)
PMA_PORT=80
GRAFANA_PORT=3000

# Target Application VM IP (OpenHouse-VM - Use host-gateway for local dev or target VM IP for prod)
APP_VM_IP=host-gateway
